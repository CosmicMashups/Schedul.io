VITE_API_BASE_URL=http://localhost:8080

# Public "Find a doctor" browsing happens before login, so there's no session to carry a
# tenant — this fills the X-Tenant-Id header for that flow. Single-tenant deployments (like
# this demo) hardcode it here; a real multi-tenant deployment would resolve it from the
# clinic's subdomain/slug instead. Required for Vercel: set as a Project env var.
VITE_DEFAULT_TENANT_ID=
